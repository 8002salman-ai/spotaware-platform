# Supabase (get from supabase.com → Settings → API)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key — REQUIRED for /api/ensure-profile and /api/admin-users
# Never expose this key publicly or commit it to version control
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Stripe (get from stripe.com → Developers → API Keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# EmailJS — for lead notifications and invoice emails
# Get from emailjs.com → Account → API Keys
EMAILJS_SERVICE_ID=service_xxx
EMAILJS_TEMPLATE_ID=template_xxx
EMAILJS_PUBLIC_KEY=xxx

# Fallback admin email for notifications (used if Supabase admin lookup fails)
ADMIN_EMAIL=your@email.com
