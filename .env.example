# ── Supabase (get from supabase.com → Settings → API) ──
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key — SERVER ONLY, never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Stripe (get from stripe.com → Developers → API Keys) ──
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── AI Chat proxy (get from openrouter.ai → Keys) ──
OPENROUTER_API_KEY=sk-or-v1-xxx

# ── Email Notifications (get from emailjs.com) ──
EMAILJS_SERVICE_ID=service_xxx
EMAILJS_TEMPLATE_ID_ADMIN=template_xxx
EMAILJS_PUBLIC_KEY=xxx
ADMIN_EMAIL=hello@yoursite.com

# ── CORS lock (set to your production domain) ──
ALLOWED_ORIGIN=https://yourdomain.com
